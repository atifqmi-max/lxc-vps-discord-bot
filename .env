# Discord bot token
DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Discord user ID(s) allowed to run admin commands, comma-separated
ADMIN_IDS=123456789012345678,987654321098765432

# Public IPv4 of the main VPS
PUBLIC_IP=103.165.11.41

# LXD image to use for newly-created VPS containers
LXC_IMAGE=images:ubuntu/24.04

# SSH port range that the bot can allocate on the main VPS
PORT_START=2200
PORT_END=2999

# Database file
DB_PATH=vps.db

# How often to check expired VPSs (seconds)
EXPIRY_CHECK_SECONDS=60
